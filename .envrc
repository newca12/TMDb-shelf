use flake

# Keep the exported environment small for remote editors (e.g. Zed on Windows via WSL/SSH).
# Windows CreateProcess has a 32,767 character limit; large Nix environments cause OS error 206
# ("The filename or extension is too long" / "Failed to spawn terminal").
dedup_flags() {
  local var=$1 out= seen=" " unit
  set -- ${!var}
  while [ $# -gt 0 ]; do
    case $1 in
      -isystem | -idirafter | -iframework | -I | -L | -rpath | -include | -Xlinker)
        unit="$1 $2"
        shift 2
        ;;
      *)
        unit="$1"
        shift
        ;;
    esac
    case $seen in
      *" $unit "*) continue ;;
    esac
    seen="$seen$unit "
    out="${out:+$out }$unit"
  done
  export "$var=$out"
}

dedup_flags NIX_CFLAGS_COMPILE
dedup_flags NIX_LDFLAGS
unset -f dedup_flags

# Unset build-platform and internal derivation variables not needed for interactive development
unset NIX_CFLAGS_COMPILE_FOR_BUILD NIX_LDFLAGS_FOR_BUILD NIX_CC_FOR_BUILD \
  NIX_BINTOOLS_FOR_BUILD CC_FOR_BUILD CXX_FOR_BUILD AR_FOR_BUILD AS_FOR_BUILD \
  LD_FOR_BUILD NM_FOR_BUILD OBJCOPY_FOR_BUILD OBJDUMP_FOR_BUILD \
  RANLIB_FOR_BUILD READELF_FOR_BUILD SIZE_FOR_BUILD STRINGS_FOR_BUILD \
  STRIP_FOR_BUILD buildInputs nativeBuildInputs propagatedBuildInputs \
  HOST_PATH depsBuildBuildPropagated depsTargetTargetPropagated depsBuildTarget \
  depsHostHostPropagated depsHostHost
